# ==============================================
# Bebsayik.com — Root Environment Template
# ==============================================
NODE_ENV=development
PORT=5000

# Canonical Domains
DOMAIN_MARKETING=bebsayik.com
DOMAIN_APP=app.bebsayik.com
DOMAIN_ADMIN=admin.bebsayik.com
DOMAIN_API=api.bebsayik.com

# Database (MongoDB Atlas / Local Replica Set)
# Atlas Template: mongodb+srv://<db_username>:<db_password>@bebsayik.6kwvimu.mongodb.net/?appName=Bebsayik
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@bebsayik.6kwvimu.mongodb.net/?appName=Bebsayik
MONGODB_DB_NAME=bebsayik_dev
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Redis Cache & Rate-Limiting
REDIS_URI=redis://localhost:6379

# Security Tokens
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_min32chars
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min32chars
SESSION_COOKIE_SECRET=dev_cookie_secret_change_in_production

# Cloudflare Turnstile CAPTCHA (Sandbox keys)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# SMS Gateway (Mock driver in dev)
SMS_GATEWAY_PROVIDER=mock
SMS_API_KEY=mock_key
SMS_SENDER_ID=Bebsayik

# Payment Gateway (Mock driver in dev)
PAYSTATION_MERCHANT_ID=mock_merchant
PAYSTATION_WEBHOOK_SECRET=mock_webhook_secret_32chars_long
