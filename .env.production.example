# ==============================================================================
# Bebsayik.com — Hardened Production Environment Template (.env.production.example)
# ==============================================================================
# IMPORTANT:
# - All secrets must be generated using cryptographically strong generators:
#   e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# - NEVER commit real production credentials to Git or Docker images.
# - Inject these variables securely via Doppler, AWS Secrets Manager, or ECS/K8s Secrets.
# ==============================================================================

NODE_ENV=production
PORT=5000

# Canonical Production Domains
DOMAIN_MARKETING=bebsayik.com
DOMAIN_APP=app.bebsayik.com
DOMAIN_ADMIN=admin.bebsayik.com
DOMAIN_API=api.bebsayik.com

# Primary Database — MongoDB Atlas 7.0+ Replica Set
# Must include replicaSet query param and majority write concern
MONGODB_URI=mongodb+srv://app_prod_user:SECURE_ATLAS_PASSWORD_HERE@bebsayik.6kwvimu.mongodb.net/?retryWrites=true&w=majority&appName=Bebsayik
MONGODB_DB_NAME=bebsayik_production
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=20

# In-Memory Cache & Distributed Locks — Redis 7+ Sentinel / Cluster
REDIS_URI=rediss://default:SECURE_REDIS_PASSWORD_HERE@redis.production.bebsayik.internal:6379

# Cryptographic Token Secrets (Minimum 64 Hex Chars / 32 Bytes recommended)
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET MUST be distinct!
JWT_ACCESS_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
SESSION_COOKIE_SECRET=9876543210abcdef9876543210abcdef9876543210abcdef9876543210abcdef

# Cloudflare Turnstile Anti-Bot CAPTCHA (Production Keys)
TURNSTILE_SITE_KEY=0x4AAAAAAAE-PRODUCTION_SITE_KEY
TURNSTILE_SECRET_KEY=0x4AAAAAAAE-PRODUCTION_SECRET_KEY

# BTRC-Approved Telecommunication SMS Gateways (SSL Wireless / BulkSMS BD)
SMS_GATEWAY_PROVIDER=ssl_wireless
SMS_API_KEY=PROD_SSL_WIRELESS_BEARER_OR_API_KEY
SMS_SENDER_ID=Bebsayik

# Production Payment Gateways & HMAC Webhook Verification Secrets
PAYSTATION_MERCHANT_ID=PROD_PAYSTATION_MERCHANT_ID
PAYSTATION_WEBHOOK_SECRET=PROD_HMAC_SECRET_AT_LEAST_32_CHARACTERS_LONG
EPS_MERCHANT_ID=PROD_EPS_MERCHANT_ID
EPS_APP_SECRET=PROD_EPS_APP_SECRET
BKASH_APP_KEY=PROD_BKASH_APP_KEY
BKASH_APP_SECRET=PROD_BKASH_APP_SECRET

# Set to true ONLY if running an offline/airgapped test container with local mongo
ALLOW_LOCAL_SERVICES_IN_PROD=false
