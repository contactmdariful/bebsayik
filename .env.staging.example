# ==============================================================================
# Bebsayik.com — Controlled Staging Environment Template (.env.staging.example)
# ==============================================================================
# SAFETY INVARIANT:
# - Staging MUST point to an isolated database (e.g. bebsayik_staging)
# - NEVER share production database credentials or production collections in staging
# - Use mock/sandbox credentials for telco SMS and bank payment gateways
# ==============================================================================

NODE_ENV=staging
PORT=5000

# Container Host Port Bindings (Avoid host collisions with dev or other stacks; localhost-only for staging safety)
STAGING_API_PORT=127.0.0.1:5000
STAGING_WEB_PORT=127.0.0.1:8080

# Canonical Staging Domains
DOMAIN_MARKETING=staging.bebsayik.com
DOMAIN_APP=staging-app.bebsayik.com
DOMAIN_ADMIN=staging-admin.bebsayik.com
DOMAIN_API=staging-api.bebsayik.com

# Staging Database — Dedicated Isolated MongoDB Database (Zero Production Data)
# Option A (MongoDB Atlas Staging Replica Set):
MONGODB_URI=mongodb+srv://staging_user:SECURE_STAGING_PASSWORD@bebsayik.6kwvimu.mongodb.net/bebsayik_staging?authSource=admin&retryWrites=true&w=majority&appName=Bebsayik
# Option B (Local Host MongoDB Replica Set via Docker Bridge):
# MONGODB_URI=mongodb://host.docker.internal:27017/bebsayik_staging?replicaSet=rs0
MONGODB_DB_NAME=bebsayik_staging
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Staging In-Memory Cache & Distributed Locks
# Option A (Containerized Redis Service in docker-compose.staging.yml):
REDIS_URI=redis://redis:6379
# Option B (External Managed Staging Redis):
# REDIS_URI=rediss://default:SECURE_STAGING_REDIS_PASSWORD@redis.staging.bebsayik.internal:6379

# Cryptographic Token Secrets (Distinct 64-character hex keys)
JWT_ACCESS_SECRET=staging_jwt_access_secret_64chars_0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=staging_jwt_refresh_secret_64chars_fedcba9876543210fedcba9876543210
SESSION_COOKIE_SECRET=staging_session_cookie_secret_64chars_9876543210abcdef0123456789abcdef

# Cloudflare Turnstile CAPTCHA (Sandbox Test Keys)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# SMS Gateway (Mock/Sandbox Provider in Staging)
SMS_GATEWAY_PROVIDER=mock
SMS_API_KEY=staging_mock_sms_key
SMS_SENDER_ID=Bebsayik

# Payment Gateways (Sandbox/Test Merchant Credentials)
PAYSTATION_MERCHANT_ID=staging_paystation_test_merchant
PAYSTATION_WEBHOOK_SECRET=staging_paystation_webhook_secret_32chars
EPS_MERCHANT_ID=staging_eps_merchant
EPS_APP_SECRET=staging_eps_secret
BKASH_APP_KEY=staging_bkash_key
BKASH_APP_SECRET=staging_bkash_secret

# Off-Site Backup S3 / Cloudflare R2 Storage
AWS_S3_BUCKET=bebsayik-staging-backups-offsite
AWS_DEFAULT_REGION=ap-southeast-1
OFFSITE_BACKUP_RETENTION_DAYS=14

# Production Overrides Disabled in Staging
ALLOW_LOCAL_SERVICES_IN_PROD=false
