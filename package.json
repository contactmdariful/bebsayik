{
  "name": "bebsayik-monorepo",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "description": "Bebsayik.com — Multi-tenant Mobile Shop ERP & POS SaaS Platform Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"cyan,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:all": "concurrently -n \"api,web,mkt,adm\" -c \"cyan,green,yellow,magenta\" \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:marketing\" \"npm run dev:admin\"",
    "dev:api": "npm run dev --workspace=@bebsayik/api",
    "dev:web": "npm run dev --workspace=@bebsayik/web-erp",
    "dev:marketing": "npm run dev --workspace=@bebsayik/marketing",
    "dev:admin": "npm run dev --workspace=@bebsayik/admin",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "vitest run packages/api/src/__tests__/e2e-master.test.ts",
    "test:auth": "vitest run packages/api/src/__tests__/auth.test.ts",
    "test:rbac": "vitest run packages/api/src/__tests__/rbac.test.ts",
    "test:inventory": "vitest run packages/api/src/__tests__/inventory.test.ts",
    "test:procurement": "vitest run packages/api/src/__tests__/procurement.test.ts",
    "test:pos": "vitest run packages/api/src/__tests__/pos.test.ts",
    "test:customers": "vitest run packages/api/src/__tests__/customers.test.ts",
    "test:kisti": "vitest run packages/api/src/__tests__/kisti.test.ts",
    "test:closing": "vitest run packages/api/src/__tests__/closing.test.ts",
    "test:onboarding": "vitest run packages/api/src/__tests__/onboarding.test.ts",
    "test:marketing": "vitest run packages/api/src/__tests__/marketing.test.ts",
    "test:billing": "vitest run packages/api/src/__tests__/billing.test.ts",
    "test:admin": "vitest run packages/api/src/__tests__/admin.test.ts",
    "test:ui": "vitest run apps/web-erp/src/__tests__/ui-components.test.ts",
    "test:production": "vitest run packages/api/src/__tests__/production.test.ts",
    "smoke:test": "node scripts/smoke-test.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build:api": "docker build -f Dockerfile.api -t bebsayik-api:latest .",
    "docker:build:web": "docker build -f Dockerfile.web -t bebsayik-web:latest .",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "seed:demo": "npm run seed:demo --workspace=@bebsayik/api",
    "migrate:up": "npm run migrate:up --workspace=@bebsayik/api",
    "db:check": "npm run db:check --workspace=@bebsayik/api",
    "db:audit:phase1": "npm run db:audit:phase1 --workspace=@bebsayik/api",
    "db:backup": "node scripts/db-backup-restore.js backup",
    "db:verify:backup": "node scripts/db-backup-restore.js verify",
    "db:archive": "node scripts/db-backup-restore.js archive",
    "db:offsite": "node scripts/db-backup-restore.js offsite",
    "db:restore": "node scripts/db-backup-restore.js restore"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "concurrently": "^10.0.6",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
