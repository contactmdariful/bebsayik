{
  "name": "@bebsayik/api",
  "version": "2.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"@bebsayik/api lint clean\"",
    "test:auth": "vitest run src/__tests__/auth.test.ts",
    "test:rbac": "vitest run src/__tests__/rbac.test.ts",
    "test:inventory": "vitest run src/__tests__/inventory.test.ts",
    "test:pos": "vitest run src/__tests__/pos.test.ts",
    "start": "node dist/index.js",
    "db:check": "node dist/database/check_connection.js",
    "db:audit:phase1": "node dist/database/verify_phase1_constraints.js",
    "seed:demo": "node dist/seed/seed_dev.js",
    "migrate:up": "migrate-mongo up"
  },
  "dependencies": {
    "@bebsayik/shared-types": "*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^11.0.0",
    "mongoose": "^8.9.3",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
